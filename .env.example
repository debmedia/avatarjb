# Local secrets for avatarjb. Copy to .env and fill the real values.

# Gemini is still typed in the browser UI today, but keeping it here lets the bridge/backend
# consume it when we move Gemini server-side.
GEMINI_API_KEY=

# HeyGen / LiveAvatar
HEYGEN_API_KEY=
LIVEAVATAR_API_KEY=
LIVEAVATAR_API_BASE=https://api.liveavatar.com
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_IS_SANDBOX=true

# Optional provider/session payload overrides for the next LITE/CUSTOM step.
LIVEAVATAR_SESSION_PAYLOAD_JSON=

